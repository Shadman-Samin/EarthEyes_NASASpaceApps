# Copy to .env for local demo use. VITE_ values are embedded in the client bundle and are public.
# For a public deployment, proxy Groq through the Worker instead of shipping a key.

# Groq (optional). Without a key, Argus and the Summary use the deterministic computed fallback.
VITE_GROQ_API_KEY=
# Fast free-tier text model. Override only with a model your account can access.
VITE_GROQ_MODEL=llama-3.3-70b-versatile
# Optional vision-capable model for image + facts interpretation.
# VITE_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Deployed catalogue Worker base (defaults to the local Vite API).
# VITE_CATALOGUE_API_BASE_URL=
