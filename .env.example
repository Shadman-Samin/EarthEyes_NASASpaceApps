# Copy to .env for local development.
# Groq is called through the server-side /api/argus proxy; no key is shipped to the browser.
# The Vite dev/preview server forwards GROQ_API_KEY (or the legacy VITE_GROQ_API_KEY) to the proxy.
GROQ_API_KEY=
# Fast free-tier text model. Override only with a model your account can access.
ARGUS_MODEL=qwen/qwen3.8-27b
# Optional vision-capable model for the Summary narrative. The server needs ARGUS_VISION_MODEL
# and the client needs VITE_GROQ_VISION_MODEL (a public flag, not a secret) to enable it.
# ARGUS_VISION_MODEL=
# VITE_GROQ_VISION_MODEL=

# Deployed catalogue Worker base (defaults to the local Vite API).
# VITE_CATALOGUE_API_BASE_URL=
